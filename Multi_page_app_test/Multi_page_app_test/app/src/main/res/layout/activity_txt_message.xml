<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".txt_message">

    <EditText
        android:id="@+id/Message_txt"
        android:layout_width="214dp"
        android:layout_height="73dp"
        android:layout_marginTop="101dp"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="16dp"
        android:ems="10"
        android:inputType="text"
        android:text="Message"
        app:layout_constraintBottom_toTopOf="@+id/txt_Number"
        app:layout_constraintEnd_toEndOf="@+id/txt_Number"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_Send"
        android:layout_width="135dp"
        android:layout_height="0dp"
        android:layout_marginBottom="340dp"
        android:text="Send"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_Number" />

    <EditText
        android:id="@+id/txt_Number"
        android:layout_width="219dp"
        android:layout_height="0dp"
        android:layout_marginBottom="90dp"
        android:ems="10"
        android:inputType="text"
        android:text="Number"
        app:layout_constraintBottom_toTopOf="@+id/btn_Send"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Message_txt" />

</androidx.constraintlayout.widget.ConstraintLayout>